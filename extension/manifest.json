{
  "manifest_version": 3,
  "name": "GiwiBridge",
  "version": "0.2.0",
  "description": "Lets a local AI agent drive this browser through the GiwiBridge MCP server.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "GiwiBridge: waiting for bridge" }
}
